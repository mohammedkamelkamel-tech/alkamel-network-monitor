<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:layoutDirection="rtl">
 <TextView android:text="مراقبة شبكة الكامل" android:textSize="24sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/summary" android:textSize="16sp" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
  <Button android:id="@+id/scan" android:text="🔍 فحص" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <Button android:id="@+id/addRange" android:text="➕ رنج" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <Button android:id="@+id/addDevice" android:text="➕ جهاز" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
 </LinearLayout>
 <Button android:id="@+id/monitor" android:text="🔴 المراقبة الخلفية: متوقفة" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/offlineFilter" android:text="🔴 غير المتصل فقط" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <ListView android:id="@+id/deviceList" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>