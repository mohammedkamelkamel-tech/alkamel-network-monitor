<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:layoutDirection="rtl" android:background="#0B1724">
 <ImageView android:id="@+id/appLogo" android:src="@drawable/app_brand" android:contentDescription="@string/app_name" android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center_horizontal" android:scaleType="fitCenter"/>
 <TextView android:text="الكامل لمراقبة أجهزة الشبكة" android:textSize="28sp" android:textStyle="bold" android:textColor="#D9F5FF" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 
 <TextView android:id="@+id/summary" android:textSize="16sp" android:textStyle="bold" android:textColor="#E9F7FF" android:padding="14dp" android:background="@drawable/panel_bg" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
  <Button android:id="@+id/scan" android:background="@drawable/button_bg" android:textColor="#F0FBFF" android:text="🔍 فحص" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <Button android:id="@+id/addRange" android:background="@drawable/button_bg" android:textColor="#F0FBFF" android:text="➕ رنج" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <Button android:id="@+id/addDevice" android:background="@drawable/button_bg" android:textColor="#F0FBFF" android:text="➕ جهاز" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
 </LinearLayout>
 <Button android:id="@+id/monitor" android:background="@drawable/button_bg" android:textColor="#F0FBFF" android:text="🔴 المراقبة الخلفية: متوقفة" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/backup" android:background="@drawable/button_bg" android:textColor="#F0FBFF" android:text="💾 نسخة احتياطية / تحديد مجلد الحفظ" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
 <Button android:id="@+id/restoreBackup" android:background="@drawable/button_bg" android:textColor="#F0FBFF" android:text="♻️ استعادة نسخة احتياطية" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
 <Button android:id="@+id/offlineFilter" android:background="@drawable/button_bg" android:textColor="#F0FBFF" android:text="🔴 غير المتصل فقط" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:text="حقوق محمد كامل - 772072056" android:textSize="13sp" android:textColor="#7FA6B8" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <ListView android:id="@+id/deviceList" android:background="#0B1724" android:divider="#244253" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>